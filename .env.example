# Copy this file to .env (local dev) and fill in real values.
# In Vercel, set these under Project Settings → Environment Variables instead.

# Postgres connection string (Vercel Postgres / Neon / local).
DATABASE_URL="postgresql://user:password@localhost:5432/hrms?schema=public"

# NextAuth / Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# Microsoft Entra ID (Azure AD) app registration — see README.md "Auth setup".
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""
# Restrict sign-in to your tenant only (recommended):
# https://login.microsoftonline.com/<your-tenant-id>/v2.0/
AUTH_MICROSOFT_ENTRA_ID_ISSUER=""

# Vercel Blob — needed for onboarding document uploads. See README.md
# "Document uploads — Vercel Blob". Get this by connecting a Blob store to
# your Vercel project, then `npx vercel env pull .env.development.local`.
BLOB_READ_WRITE_TOKEN=""

# Automated reminders — see README.md "Automated reminders — Resend +
# Vercel Cron". Without these, reminders just log to the console.
RESEND_API_KEY=""
EMAIL_FROM="HRMS <notifications@yourdomain.com>"
# Random 16+ character string — Vercel sends it back as the cron job's
# Authorization header. The reminders route refuses every request without it.
CRON_SECRET=""

# Optional — posts the daily HR digest to a Microsoft Teams channel too
# (PRD §32). See README.md "Teams notifications" for how to get this URL,
# and an important caveat about which kind of webhook your Teams tenant
# currently offers. Without it, this just logs to the console.
TEAMS_WEBHOOK_URL=""

# Optional — your production URL, used for links inside reminder emails.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
