// HRMS Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — standard adapter schema.
// See https://authjs.dev/getting-started/adapters/prisma if you change this.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// HRMS core models
// ---------------------------------------------------------------------------

/// Application role. Assigned by an HR Admin; drives RBAC (PRD §4, §30).
enum Role {
  HR_ADMIN
  HR_EXECUTIVE
  MANAGER
  EMPLOYEE
  MANAGEMENT
}

/// A login identity (created on first Microsoft Entra ID sign-in).
/// Linked to at most one Employee record, matched by email.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)

  accounts Account[]
  sessions Session[]

  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmploymentStatus {
  CANDIDATE
  OFFER_ACCEPTED
  PRE_BOARDING
  ONBOARDING
  PROBATION
  CONFIRMED
  ACTIVE
  NOTICE_PERIOD
  EXITED
  ALUMNI
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

/// Single source of truth for employee data (PRD §7).
model Employee {
  id           String @id @default(cuid())
  employeeCode String @unique // human-readable Employee ID, e.g. EMP-0001

  // Optional link to a login identity — set once the person signs in via SSO.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // --- Personal information ---
  fullName              String
  preferredName         String?
  dateOfBirth           DateTime?
  gender                String?
  personalEmail         String?
  personalPhone         String?
  currentAddress        String?
  permanentAddress      String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // --- Employment information ---
  dateOfJoining      DateTime
  department         String
  designation        String
  location           String?
  employmentType     EmploymentType @default(FULL_TIME)
  workMode           WorkMode       @default(ON_SITE)
  reportingManagerId String?
  reportingManager   Employee?      @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports      Employee[]     @relation("ManagerReports")

  probationEndDate DateTime?
  confirmationDate DateTime?
  noticePeriodDays Int?
  resignationDate  DateTime?
  lastWorkingDay   DateTime?

  status                       EmploymentStatus              @default(PRE_BOARDING)
  statusHistory                EmployeeStatusHistory[]
  onboardingDocuments          OnboardingDocument[]
  itTasks                      ITOnboardingTask[]
  leaveBalances                LeaveBalance[]
  leaveRequests                LeaveRequest[]
  attendanceRecords            AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]
  wfhRequests                  WFHRequest[]
  exitChecklistItems           ExitChecklistItem[]
  assignedAssets               Asset[]
  hrRequests                   HRRequest[]
  goals                        Goal[]
  performanceReviews           PerformanceReview[]
  performanceImprovementPlans  PerformanceImprovementPlan[]
  recognitionsGiven            Recognition[]                 @relation("RecognitionsGiven")
  recognitionsReceived         Recognition[]                 @relation("RecognitionsReceived")

  // --- Compensation (restricted — enforce in query layer, PRD §7/§30) ---
  ctcAnnual Decimal? @db.Decimal(14, 2)

  // --- Bank / statutory (restricted) ---
  panNumber         String?
  aadhaarNumber     String?
  uan               String?
  bankAccountNumber String?
  bankIfsc          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([reportingManagerId])
}

/// Every lifecycle status change, with who/when/why (PRD §8, §31).
model EmployeeStatusHistory {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousStatus EmploymentStatus?
  newStatus      EmploymentStatus
  reason         String?
  changedById    String? // User.id of the HR user who made the change
  changedAt      DateTime          @default(now())

  @@index([employeeId])
}

/// Generic audit trail for sensitive field changes (PRD §31). entityType is
/// e.g. "Employee" (field edits) or "User" (role changes) — see
/// src/lib/actions/employee-detail.ts and src/lib/actions/user-role.ts.
model AuditLog {
  id          String   @id @default(cuid())
  entityType  String // e.g. "Employee"
  entityId    String
  field       String
  oldValue    String?
  newValue    String?
  reason      String?
  changedById String?
  changedAt   DateTime @default(now())

  @@index([entityType, entityId])
}

/// Atomic counters for generating human-readable sequential codes (e.g.
/// employeeCode). A row-level UPDATE inside a transaction is atomic under
/// Postgres's read-committed default, avoiding the count()+1 race a plain
/// SELECT COUNT(*) would have.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Onboarding (PRD §10–§11). Both checklists are created automatically —
// one row per enum value — the moment an Employee record is created (see
// src/lib/actions/employee.ts), inside the same transaction as the insert.
// ---------------------------------------------------------------------------

enum DocumentType {
  PAN
  AADHAAR
  EDUCATION_CERTIFICATE
  PREVIOUS_EMPLOYMENT_PROOF
  BANK_PROOF
  PHOTOGRAPH
  EXPERIENCE_LETTER
  RELIEVING_LETTER
}

enum DocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

/// One row per required document per employee (PRD §10). The file itself
/// lives in Vercel Blob as a **private** object (requires our own
/// authenticated proxy route to read — see src/app/api/documents/[id]/
/// route.ts) — these can be PAN/Aadhaar/bank proof, so nothing here is
/// ever a directly browsable public URL.
model OnboardingDocument {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       DocumentType
  status     DocumentStatus @default(NOT_SUBMITTED)
  notes      String?

  // --- Uploaded file (all null until something is uploaded) ---
  blobPathname String? // pass to @vercel/blob's get()/del(), not a public URL
  fileName     String?
  fileSize     Int?
  contentType  String?
  uploadedById String? // User.id — the employee themselves, or HR on their behalf
  uploadedAt   DateTime?

  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([employeeId, type])
  @@index([employeeId])
}

enum ITTaskType {
  LAPTOP_ALLOCATION
  EMAIL_CREATION
  HRMS_ACCESS
  COMMUNICATION_TOOL_ACCESS
  VPN_ACCESS
  APPLICATION_ACCESS
  SOFTWARE_INSTALLATION
  SECURITY_ACCESS
}

enum ITTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// One row per IT setup task per employee (PRD §11).
model ITOnboardingTask {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       ITTaskType
  status     ITTaskStatus @default(PENDING)
  notes      String?
  updatedAt  DateTime     @updatedAt
  createdAt  DateTime     @default(now())

  @@unique([employeeId, type])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Leave management (PRD §14). Accrual/encashment (also in PRD §14) are NOT
// implemented. Carry-forward is: at most `carryForwardLimit` unused days
// roll into the next year's `allocated`, computed once when that year's
// balance is lazily created — see ensureLeaveBalance in src/lib/leave-balance.ts.
// ---------------------------------------------------------------------------

/// Org-wide leave type configuration, managed at /dashboard/leave-types.
/// Seeded with 3 defaults the first time an employee is created (see
/// src/lib/actions/employee.ts).
model LeaveType {
  id                String   @id @default(cuid())
  name              String   @unique
  annualDays        Float
  /// Max unused days that carry into next year's balance. 0 = none (the
  /// default for the 3 seeded types, preserving prior behavior).
  carryForwardLimit Float    @default(0)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]
}

/// One row per employee per leave type per calendar year.
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Float
  used        Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Employee applies -> manager (or HR) approves/rejects -> balance updates
/// on approval, not on application (PRD §14 workflow).
model LeaveRequest {
  id             String             @id @default(cuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  approverId     String? // User.id of whoever approved/rejected
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime           @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Attendance (PRD §13). No external attendance-device integration (PRD §32
// frames that as a separate integration).
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WORK_FROM_HOME
  HOLIDAY
  ON_LEAVE
  MISSING
}

/// One row per employee per calendar day. `date` is stored as UTC midnight
/// of the calendar day (same convention as Employee.dateOfJoining) — always
/// format for display with an explicit UTC timeZone.
model AttendanceRecord {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime
  status     AttendanceStatus
  notes      String?
  markedById String? // User.id of the HR user who set this
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Employee-initiated dispute of an attendance record (PRD §13 workflow:
/// "Employee submits correction request → Manager approval → HR
/// visibility"). Approving one applies `requestedStatus` to the
/// AttendanceRecord for (employeeId, date) and writes an AuditLog entry —
/// same as a direct HR override in markAttendance (PRD's "HR should be
/// able to override/correct attendance with an audit trail").
model AttendanceCorrectionRequest {
  id              String                     @id @default(cuid())
  employeeId      String
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  currentStatus   AttendanceStatus? // snapshot at request time; null = no record existed
  requestedStatus AttendanceStatus
  reason          String
  status          AttendanceCorrectionStatus @default(PENDING)
  approverId      String?
  decidedAt       DateTime?
  decisionReason  String?
  createdAt       DateTime                   @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Exit / Separation (PRD §24–§26). initiateExit (src/lib/actions/exit.ts)
// records resignationDate/noticePeriodDays, computes lastWorkingDay, moves
// status to NOTICE_PERIOD, and seeds one checklist row per type below — the
// same "seed everything the moment the transition happens" pattern
// createEmployee already uses for onboarding.
//
// Simplification from the PRD's literal workflow: there's no separate
// employee-submits-resignation → manager-approves gate before this — HR
// records the resignation directly (realistic either way, since HR ends
// up recording it in the system regardless of how the conversation
// happened). Nothing blocks moving status to EXITED before every checklist
// item is COMPLETED, either. See README "Known items to revisit".
// ---------------------------------------------------------------------------

enum ExitChecklistItemType {
  MANAGER_CONFIRMATION
  HR_DISCUSSION
  KNOWLEDGE_TRANSFER
  ASSET_RETURN
  ACCESS_REVOCATION
  CLEARANCE
  EXIT_INTERVIEW
  FINAL_SETTLEMENT
  EXPERIENCE_LETTER
  RELIEVING_LETTER
}

enum ExitChecklistItemStatus {
  PENDING
  COMPLETED
}

/// One row per exit checklist step per employee (PRD §24). "Resignation
/// received" isn't its own row here — initiating the exit at all implies
/// it, per the simplification noted above.
model ExitChecklistItem {
  id            String                  @id @default(cuid())
  employeeId    String
  employee      Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type          ExitChecklistItemType
  status        ExitChecklistItemStatus @default(PENDING)
  notes         String?
  completedById String?
  completedAt   DateTime?
  createdAt     DateTime                @default(now())

  @@unique([employeeId, type])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Assets (PRD §26). Deliberately minimal — just enough to make the exit
// checklist's "Asset Return" step real. Issuing during onboarding,
// damage/condition history, and richer IT-asset tracking are still a
// separate roadmap item.
// ---------------------------------------------------------------------------

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  UNDER_REPAIR
  RETURNED
  LOST
  RETIRED
}

model Asset {
  id                 String      @id @default(cuid())
  assetCode          String      @unique // human-readable, e.g. AST-0001
  type               String // free text, e.g. "Laptop" — org-specific, like Employee.department
  serialNumber       String?
  assignedEmployeeId String?
  assignedEmployee   Employee?   @relation(fields: [assignedEmployeeId], references: [id])
  condition          String?
  status             AssetStatus @default(AVAILABLE)
  issueDate          DateTime?
  returnDate         DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  history AssetHistory[]

  @@index([assignedEmployeeId])
  @@index([status])
}

enum AssetHistoryAction {
  ASSIGNED
  RETURNED
  CONDITION_UPDATED
  RETIRED
  LOST
}

/// Every assignment/return/condition-change/retirement/loss event for an
/// asset, so damage/condition history (PRD §26) is a real log rather than
/// just the single free-text `Asset.condition` field reflecting whatever
/// happened most recently.
model AssetHistory {
  id            String             @id @default(cuid())
  assetId       String
  asset         Asset              @relation(fields: [assetId], references: [id], onDelete: Cascade)
  action        AssetHistoryAction
  employeeId    String? // who the asset was assigned to/returned from, if relevant
  condition     String?
  notes         String?
  performedById String? // User.id
  occurredAt    DateTime           @default(now())

  @@index([assetId])
}

// ---------------------------------------------------------------------------
// Work From Home (PRD §15). Separate request/approval workflow from Leave
// and from attendance corrections — approving one writes WORK_FROM_HOME
// directly onto the covered AttendanceRecord rows (+ AuditLog), same
// authoritative-override pattern as an approved correction.
//
// NOT implemented: WFH eligibility, max-days policy, and location
// restrictions (all PRD §15 configuration items) — there's no policy
// engine yet, just the request/approve/reflect-in-attendance mechanics.
// See README "Known items to revisit".
// ---------------------------------------------------------------------------

enum WFHRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model WFHRequest {
  id             String           @id @default(cuid())
  employeeId     String
  employee       Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  startDate      DateTime
  endDate        DateTime
  reason         String
  status         WFHRequestStatus @default(PENDING)
  approverId     String?
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime         @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// HR Helpdesk (PRD §21). No comment thread — a request is one description
// plus one resolution note, not a running conversation. No configurable
// SLA policy either; "SLA visibility" here is just "how many days has this
// been open", surfaced in the UI, not a per-category target with alerts.
// ---------------------------------------------------------------------------

enum HRRequestCategory {
  LEAVE
  ATTENDANCE
  SALARY_DOCUMENTS
  EMPLOYMENT_LETTERS
  PERSONAL_INFO_UPDATE
  POLICY_CLARIFICATION
  BENEFITS
  PAYROLL_QUERY
  OTHER
}

enum HRRequestStatus {
  SUBMITTED
  ASSIGNED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model HRRequest {
  id             String            @id @default(cuid())
  employeeId     String
  employee       Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  category       HRRequestCategory
  subject        String
  description    String
  status         HRRequestStatus   @default(SUBMITTED)
  assignedToId   String? // User.id of the HR person handling it
  resolutionNote String?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Performance management (PRD §17–§18: goal setting, self/manager reviews,
// ratings, and performance improvement plans). The exact PRD §17–§18 wording
// wasn't available while building this (only the roadmap's one-line
// summary in README) — this is a reasonable, standard performance-cycle +
// PIP design consistent with the rest of this schema, not a literal
// transcription of the PRD. Flag any mismatch with your actual PRD text.
// ---------------------------------------------------------------------------

enum PerformanceCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

/// A review period (e.g. "H1 2026", "Annual 2026"), managed by HR at
/// /dashboard/performance. Goals and reviews only exist within one of these.
model PerformanceCycle {
  id                   String                 @id @default(cuid())
  name                 String                 @unique
  startDate            DateTime
  endDate              DateTime
  selfReviewDueDate    DateTime?
  managerReviewDueDate DateTime?
  status               PerformanceCycleStatus @default(DRAFT)
  createdAt            DateTime               @default(now())

  goals   Goal[]
  reviews PerformanceReview[]

  @@index([status])
}

enum GoalStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

/// One goal an employee is working toward within a cycle. `weight` is a
/// convention (intended to sum to ~100 across an employee's goals in a
/// cycle) that the UI surfaces but doesn't enforce.
model Goal {
  id            String           @id @default(cuid())
  employeeId    String
  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId       String
  cycle         PerformanceCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  weight        Float            @default(0)
  status        GoalStatus       @default(NOT_STARTED)
  selfRating    Int? // 1-5, set when the employee submits their self-review
  managerRating Int? // 1-5, set when the manager submits their review
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([employeeId])
  @@index([cycleId])
}

enum PerformanceReviewStatus {
  NOT_STARTED
  SELF_REVIEW
  MANAGER_REVIEW
  COMPLETED
}

/// One row per employee per cycle, tracking the self-review → manager-review
/// workflow. Created lazily the first time an employee or their manager
/// touches a cycle (mirrors ensureLeaveBalance's lazy-create pattern).
model PerformanceReview {
  id                   String                  @id @default(cuid())
  employeeId           String
  employee             Employee                @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  cycleId              String
  cycle                PerformanceCycle        @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  reviewerId           String? // User.id of the manager who submitted the review
  status               PerformanceReviewStatus @default(NOT_STARTED)
  selfComments         String?
  selfSubmittedAt      DateTime?
  managerComments      String?
  managerOverallRating Int? // 1-5
  managerSubmittedAt   DateTime?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt

  @@unique([employeeId, cycleId])
  @@index([employeeId])
  @@index([cycleId])
}

enum PIPStatus {
  ACTIVE
  COMPLETED_SUCCESS
  COMPLETED_FAILURE
  CANCELLED
}

/// A performance improvement plan — independent of review cycles, since a
/// PIP can be initiated at any time. `goals` is free text (the specific
/// expectations/targets), not a link to the Goal model above.
model PerformanceImprovementPlan {
  id            String    @id @default(cuid())
  employeeId    String
  employee      Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  initiatedById String? // User.id
  reason        String
  goals         String
  startDate     DateTime
  endDate       DateTime
  status        PIPStatus @default(ACTIVE)
  outcomeNotes  String?
  closedById    String? // User.id
  closedAt      DateTime?
  createdAt     DateTime  @default(now())

  checkIns PIPCheckIn[]

  @@index([employeeId])
  @@index([status])
}

/// A periodic progress note logged against an active PIP.
model PIPCheckIn {
  id          String                     @id @default(cuid())
  pipId       String
  pip         PerformanceImprovementPlan @relation(fields: [pipId], references: [id], onDelete: Cascade)
  note        String
  createdById String? // User.id
  createdAt   DateTime                   @default(now())

  @@index([pipId])
}

// ---------------------------------------------------------------------------
// Employee recognition (PRD §19: peer/manager recognition with categories
// and points). Exact PRD §19 wording wasn't available while building this
// (only the roadmap's one-line summary) — categories, the 1-100 point
// range, and the org-wide-visible feed are a reasonable standard design,
// not a literal transcription. Flag any mismatch with your actual PRD text.
// ---------------------------------------------------------------------------

enum RecognitionCategory {
  TEAMWORK
  INNOVATION
  CUSTOMER_FOCUS
  LEADERSHIP
  GOING_ABOVE_AND_BEYOND
  OTHER
}

/// One peer-or-manager recognition, visible org-wide (celebrating people is
/// the point). Points aren't tied to any budget/redemption system — the
/// point total here is just a running "how recognized is this person"
/// signal (PRD §19's "points"), not a spendable currency.
model Recognition {
  id             String              @id @default(cuid())
  fromEmployeeId String
  fromEmployee   Employee            @relation("RecognitionsGiven", fields: [fromEmployeeId], references: [id], onDelete: Cascade)
  toEmployeeId   String
  toEmployee     Employee            @relation("RecognitionsReceived", fields: [toEmployeeId], references: [id], onDelete: Cascade)
  category       RecognitionCategory
  points         Int                 @default(10)
  message        String
  createdAt      DateTime            @default(now())

  @@index([toEmployeeId])
  @@index([fromEmployeeId])
}
