// HRMS Prisma schema
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth v5) models — standard adapter schema.
// See https://authjs.dev/getting-started/adapters/prisma if you change this.
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// HRMS core models
// ---------------------------------------------------------------------------

/// Application role. Assigned by an HR Admin; drives RBAC (PRD §4, §30).
enum Role {
  HR_ADMIN
  HR_EXECUTIVE
  MANAGER
  EMPLOYEE
  MANAGEMENT
}

/// A login identity (created on first Microsoft Entra ID sign-in).
/// Linked to at most one Employee record, matched by email.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          Role      @default(EMPLOYEE)

  accounts Account[]
  sessions Session[]

  employee Employee?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum EmploymentStatus {
  CANDIDATE
  OFFER_ACCEPTED
  PRE_BOARDING
  ONBOARDING
  PROBATION
  CONFIRMED
  ACTIVE
  NOTICE_PERIOD
  EXITED
  ALUMNI
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

/// Single source of truth for employee data (PRD §7).
model Employee {
  id             String  @id @default(cuid())
  employeeCode   String  @unique // human-readable Employee ID, e.g. EMP-0001

  // Optional link to a login identity — set once the person signs in via SSO.
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // --- Personal information ---
  fullName         String
  preferredName    String?
  dateOfBirth      DateTime?
  gender           String?
  personalEmail    String?
  personalPhone    String?
  currentAddress   String?
  permanentAddress String?
  emergencyContactName  String?
  emergencyContactPhone String?

  // --- Employment information ---
  dateOfJoining     DateTime
  department        String
  designation       String
  location          String?
  employmentType    EmploymentType   @default(FULL_TIME)
  workMode          WorkMode         @default(ON_SITE)
  reportingManagerId String?
  reportingManager   Employee?       @relation("ManagerReports", fields: [reportingManagerId], references: [id])
  directReports      Employee[]      @relation("ManagerReports")

  probationEndDate  DateTime?
  confirmationDate  DateTime?
  noticePeriodDays  Int?
  resignationDate   DateTime?
  lastWorkingDay    DateTime?

  status            EmploymentStatus @default(PRE_BOARDING)
  statusHistory     EmployeeStatusHistory[]
  onboardingDocuments OnboardingDocument[]
  itTasks             ITOnboardingTask[]
  leaveBalances       LeaveBalance[]
  leaveRequests       LeaveRequest[]
  attendanceRecords   AttendanceRecord[]
  attendanceCorrectionRequests AttendanceCorrectionRequest[]

  // --- Compensation (restricted — enforce in query layer, PRD §7/§30) ---
  ctcAnnual         Decimal?  @db.Decimal(14, 2)

  // --- Bank / statutory (restricted) ---
  panNumber         String?
  aadhaarNumber     String?
  uan               String?
  bankAccountNumber String?
  bankIfsc          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([department])
  @@index([status])
  @@index([reportingManagerId])
}

/// Every lifecycle status change, with who/when/why (PRD §8, §31).
model EmployeeStatusHistory {
  id            String            @id @default(cuid())
  employeeId    String
  employee      Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  previousStatus EmploymentStatus?
  newStatus     EmploymentStatus
  reason        String?
  changedById   String? // User.id of the HR user who made the change
  changedAt     DateTime          @default(now())

  @@index([employeeId])
}

/// Generic audit trail for sensitive field changes (PRD §31). entityType is
/// e.g. "Employee" (field edits) or "User" (role changes) — see
/// src/lib/actions/employee-detail.ts and src/lib/actions/user-role.ts.
model AuditLog {
  id         String   @id @default(cuid())
  entityType String   // e.g. "Employee"
  entityId   String
  field      String
  oldValue   String?
  newValue   String?
  reason     String?
  changedById String?
  changedAt  DateTime @default(now())

  @@index([entityType, entityId])
}

/// Atomic counters for generating human-readable sequential codes (e.g.
/// employeeCode). A row-level UPDATE inside a transaction is atomic under
/// Postgres's read-committed default, avoiding the count()+1 race a plain
/// SELECT COUNT(*) would have.
model Counter {
  name  String @id
  value Int    @default(0)
}

// ---------------------------------------------------------------------------
// Onboarding (PRD §10–§11). Both checklists are created automatically —
// one row per enum value — the moment an Employee record is created (see
// src/lib/actions/employee.ts), inside the same transaction as the insert.
// ---------------------------------------------------------------------------

enum DocumentType {
  PAN
  AADHAAR
  EDUCATION_CERTIFICATE
  PREVIOUS_EMPLOYMENT_PROOF
  BANK_PROOF
  PHOTOGRAPH
  EXPERIENCE_LETTER
  RELIEVING_LETTER
}

enum DocumentStatus {
  NOT_SUBMITTED
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  RESUBMISSION_REQUIRED
}

/// One row per required document per employee (PRD §10). The file itself
/// lives in Vercel Blob as a **private** object (requires our own
/// authenticated proxy route to read — see src/app/api/documents/[id]/
/// route.ts) — these can be PAN/Aadhaar/bank proof, so nothing here is
/// ever a directly browsable public URL.
model OnboardingDocument {
  id         String         @id @default(cuid())
  employeeId String
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       DocumentType
  status     DocumentStatus @default(NOT_SUBMITTED)
  notes      String?

  // --- Uploaded file (all null until something is uploaded) ---
  blobPathname String? // pass to @vercel/blob's get()/del(), not a public URL
  fileName     String?
  fileSize     Int?
  contentType  String?
  uploadedById String? // User.id — the employee themselves, or HR on their behalf
  uploadedAt   DateTime?

  updatedAt  DateTime       @updatedAt
  createdAt  DateTime       @default(now())

  @@unique([employeeId, type])
  @@index([employeeId])
}

enum ITTaskType {
  LAPTOP_ALLOCATION
  EMAIL_CREATION
  HRMS_ACCESS
  COMMUNICATION_TOOL_ACCESS
  VPN_ACCESS
  APPLICATION_ACCESS
  SOFTWARE_INSTALLATION
  SECURITY_ACCESS
}

enum ITTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

/// One row per IT setup task per employee (PRD §11).
model ITOnboardingTask {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       ITTaskType
  status     ITTaskStatus @default(PENDING)
  notes      String?
  updatedAt  DateTime     @updatedAt
  createdAt  DateTime     @default(now())

  @@unique([employeeId, type])
  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// Leave management (PRD §14). Carry-forward/accrual/encashment (also in
// PRD §14) are NOT implemented — every LeaveBalance is a flat per-year
// allocation, lazily created at the employee's default entitlement the
// first time it's needed. See README "Known items to revisit".
// ---------------------------------------------------------------------------

/// Org-wide leave type configuration. Seeded with 3 defaults the first time
/// an employee is created (see src/lib/actions/employee.ts); HR can't add
/// more via the UI yet (see roadmap).
model LeaveType {
  id          String  @id @default(cuid())
  name        String  @unique
  annualDays  Float
  isActive    Boolean @default(true)
  createdAt   DateTime @default(now())

  balances LeaveBalance[]
  requests LeaveRequest[]
}

/// One row per employee per leave type per calendar year.
model LeaveBalance {
  id          String    @id @default(cuid())
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId String
  leaveType   LeaveType @relation(fields: [leaveTypeId], references: [id])
  year        Int
  allocated   Float
  used        Float     @default(0)

  @@unique([employeeId, leaveTypeId, year])
  @@index([employeeId])
}

enum LeaveRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Employee applies -> manager (or HR) approves/rejects -> balance updates
/// on approval, not on application (PRD §14 workflow).
model LeaveRequest {
  id             String             @id @default(cuid())
  employeeId     String
  employee       Employee           @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveTypeId    String
  leaveType      LeaveType          @relation(fields: [leaveTypeId], references: [id])
  startDate      DateTime
  endDate        DateTime
  days           Float
  reason         String?
  status         LeaveRequestStatus @default(PENDING)
  approverId     String? // User.id of whoever approved/rejected
  decidedAt      DateTime?
  decisionReason String?
  createdAt      DateTime           @default(now())

  @@index([employeeId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Attendance (PRD §13). No external attendance-device integration (PRD §32
// frames that as a separate integration).
// ---------------------------------------------------------------------------

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  WORK_FROM_HOME
  HOLIDAY
  ON_LEAVE
  MISSING
}

/// One row per employee per calendar day. `date` is stored as UTC midnight
/// of the calendar day (same convention as Employee.dateOfJoining) — always
/// format for display with an explicit UTC timeZone.
model AttendanceRecord {
  id           String           @id @default(cuid())
  employeeId   String
  employee     Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date         DateTime
  status       AttendanceStatus
  notes        String?
  markedById   String? // User.id of the HR user who set this
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@unique([employeeId, date])
  @@index([employeeId])
  @@index([date])
}

enum AttendanceCorrectionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

/// Employee-initiated dispute of an attendance record (PRD §13 workflow:
/// "Employee submits correction request → Manager approval → HR
/// visibility"). Approving one applies `requestedStatus` to the
/// AttendanceRecord for (employeeId, date) and writes an AuditLog entry —
/// same as a direct HR override in markAttendance (PRD's "HR should be
/// able to override/correct attendance with an audit trail").
model AttendanceCorrectionRequest {
  id              String                     @id @default(cuid())
  employeeId      String
  employee        Employee                   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date            DateTime
  currentStatus   AttendanceStatus? // snapshot at request time; null = no record existed
  requestedStatus AttendanceStatus
  reason          String
  status          AttendanceCorrectionStatus @default(PENDING)
  approverId      String?
  decidedAt       DateTime?
  decisionReason  String?
  createdAt       DateTime                   @default(now())

  @@index([employeeId])
  @@index([status])
}
